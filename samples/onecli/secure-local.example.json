{
  "version": 1,
  "binds": {
    "dashboard": {
      "host": "127.0.0.1",
      "port": 10254
    },
    "gateway": {
      "host": "127.0.0.1",
      "port": 10255
    },
    "postgres": {
      "host": "127.0.0.1",
      "port": 5432
    }
  },
  "images": {
    "onecli": "<pin-reviewed-onecli-image-tag-or-digest>",
    "postgres": "<pin-reviewed-postgres-image-tag-or-digest>"
  },
