  },
  "encryptionKey": "<generate-encryption-key-outside-this-repository>",
  "bitwardenRelayUrl": "https://<approved-bitwarden-relay-host>",
  "credentialCacheTtlSeconds": 60,
  "separateRuntimeBoundaryAcknowledged": true
