#!/usr/bin/osascript
/**
 * macOS SM secret-entry dialog. Reads a value-free form JSON file.
 * Prints one JSON line: { ok, cancelled, values } or { ok:false, code }.
 * The Node wrapper must never re-emit `values`.
 */
ObjC.import('Cocoa')
ObjC.import('Foundation')

function unwrap(value) {
  if (value === null || value === undefined) return ''
  return ObjC.unwrap(value)
}

function parseArgs() {
  const args = ObjC.deepUnwrap($.NSProcessInfo.processInfo.arguments)
  const out = { formPath: '' }
  for (let i = 0; i < args.length; i += 1) {
    if (args[i] === '--form-path' && i + 1 < args.length) {
      out.formPath = String(args[i + 1])
    }
  }
  return out
}

function writeJson(obj) {
  const json = JSON.stringify(obj)
  const data = $.NSString.alloc.initWithUTF8String(json).dataUsingEncoding($.NSUTF8StringEncoding)
  $.NSFileHandle.fileHandleWithStandardOutput.writeData(data)
}

function makeLabel(text, frame) {
  const label = $.NSTextField.alloc.initWithFrame(frame)
  label.stringValue = text
  label.bezeled = false
  label.drawsBackground = false
  label.editable = false
  label.selectable = false
  return label
}

function installTextEditing() {
  const app = $.NSApplication.sharedApplication
  try {
    app.setActivationPolicy($.NSApplicationActivationPolicyRegular)
  } catch (error) {
    // osascript may already be a regular app
  }
  const menubar = $.NSMenu.alloc.init
  const editItem = $.NSMenuItem.alloc.initWithTitleActionKeyEquivalent('Edit', null, '')
  const editMenu = $.NSMenu.alloc.initWithTitle('Edit')
  editMenu.addItemWithTitleActionKeyEquivalent('Cut', 'cut:', 'x')
  editMenu.addItemWithTitleActionKeyEquivalent('Copy', 'copy:', 'c')
  editMenu.addItemWithTitleActionKeyEquivalent('Paste', 'paste:', 'v')
  editMenu.addItemWithTitleActionKeyEquivalent('Select All', 'selectAll:', 'a')
  editItem.submenu = editMenu
  menubar.addItem(editItem)
  app.mainMenu = menubar
}

function readForm(formPath) {
  const nsPath = $.NSString.stringWithUTF8String(formPath)
  const data = $.NSData.dataWithContentsOfFile(nsPath)
  if (!data) return null
  const obj = $.NSJSONSerialization.JSONObjectWithDataOptionsError(data, 0, null)
  if (!obj) return null
  return ObjC.deepUnwrap(obj)
}

const opts = parseArgs()
const form = readForm(opts.formPath)
if (!form || !Array.isArray(form.fields) || form.fields.length < 1) {
  writeJson({ ok: false, code: 'form_invalid' })
} else {
  installTextEditing()
  $.NSApplication.sharedApplication.activateIgnoringOtherApps(true)

  const alert = $.NSAlert.alloc.init
  alert.messageText = String(form.title || 'Secrets Manager')
  alert.informativeText = String(form.info || 'Paste values locally. Secrets are written to Secrets Manager, never to chat.')
  alert.addButtonWithTitle('Save')
  alert.addButtonWithTitle('Cancel')

  const fields = form.fields
  const rowH = 48
  const width = 440
  const height = Math.max(48, fields.length * rowH)
  const accessory = $.NSView.alloc.initWithFrame($.NSMakeRect(0, 0, width, height))
  const boxes = []

  for (let i = 0; i < fields.length; i += 1) {
    const field = fields[i]
    const y = height - ((i + 1) * rowH) + 8
    const caption = String(field.label || field.sm_key)
    accessory.addSubview(makeLabel(caption, $.NSMakeRect(0, y + 18, width, 18)))
    const isSecret = field.kind === 'password' || field.secret === true
    const box = isSecret
      ? $.NSSecureTextField.alloc.initWithFrame($.NSMakeRect(0, y, width, 24))
      : $.NSTextField.alloc.initWithFrame($.NSMakeRect(0, y, width, 24))
    box.editable = true
    box.selectable = true
    accessory.addSubview(box)
    boxes.push({ sm_key: String(field.sm_key), box: box })
  }

  alert.accessoryView = accessory
  if (boxes.length > 0) {
    try {
      alert.window.initialFirstResponder = boxes[0].box
      alert.window.makeFirstResponder(boxes[0].box)
    } catch (error) {
      boxes[0].box.becomeFirstResponder
    }
  }

  const response = alert.runModal()
  const saved = response === $.NSAlertFirstButtonReturn || Number(response) === 1000
  if (!saved) {
    writeJson({ ok: false, cancelled: true, code: 'cancelled' })
  } else {
    const values = {}
    for (let i = 0; i < boxes.length; i += 1) {
      const text = unwrap(boxes[i].box.stringValue)
      if (text.length > 0) {
        values[boxes[i].sm_key] = text
      }
    }
    writeJson({ ok: true, cancelled: false, values: values })
  }
}
