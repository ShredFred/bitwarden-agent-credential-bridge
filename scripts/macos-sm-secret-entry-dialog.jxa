#!/usr/bin/osascript
/**
 * macOS SM secret-entry dialog. Reads a value-free form JSON file.
 * Prints one JSON line: { ok, cancelled, values } or { ok:false, code }.
 * The Node wrapper must never re-emit `values`.
 */
ObjC.import('Cocoa')
ObjC.import('Foundation')

function unwrap(value) {
  if (value === null || value === undefined) return ''
  return ObjC.unwrap(value)
}

function parseArgs() {
  const args = ObjC.deepUnwrap($.NSProcessInfo.processInfo.arguments)
  const out = { formPath: '' }
  for (let i = 0; i < args.length; i += 1) {
    if (args[i] === '--form-path' && i + 1 < args.length) {
      out.formPath = String(args[i + 1])
    }
  }
  return out
}

function writeJson(obj) {
  const json = JSON.stringify(obj)
  const data = $.NSString.alloc.initWithUTF8String(json).dataUsingEncoding($.NSUTF8StringEncoding)
  $.NSFileHandle.fileHandleWithStandardOutput.writeData(data)
}

function makeLabel(text, frame) {
  const label = $.NSTextField.alloc.initWithFrame(frame)
  label.stringValue = text
  label.bezeled = false
  label.drawsBackground = false
  label.editable = false
  label.selectable = false
  return label
}

// Keep action targets alive for the entire modal session.
const visibilityRows = []
function toggleSecretVisibility(index) {
  const row = visibilityRows[index]
  if (!row) return
  const previous = row.box
  const next = row.revealed ? row.secureBox : row.plainBox
  const window = previous.window
  // Commit the shared field editor before transferring the current value.
  if (window && typeof window.makeFirstResponder === 'function') window.makeFirstResponder(null)
  next.stringValue = previous.stringValue
  previous.stringValue = ''
  previous.hidden = true
  next.hidden = false
  row.box = next
  row.revealed = !row.revealed
  row.button.title = row.revealed ? 'Hide' : 'Show'
  row.button.setAccessibilityLabel((row.revealed ? 'Hide ' : 'Show ') + row.caption)
  if (window && typeof window.makeFirstResponder === 'function') window.makeFirstResponder(next)
}
ObjC.registerSubclass({
  name: 'BridgeSecretVisibilityTarget',
  superclass: 'NSObject',
  methods: {
    'toggleSecret:': {
      types: ['void', ['id']],
      implementation: function (sender) { toggleSecretVisibility(Number(sender.tag)) },
    },
  },
})
const visibilityTarget = $.BridgeSecretVisibilityTarget.alloc.init

function installTextEditing() {
  const app = $.NSApplication.sharedApplication
  try {
    app.setActivationPolicy($.NSApplicationActivationPolicyRegular)
  } catch (error) {
    // osascript may already be a regular app
  }
  const menubar = $.NSMenu.alloc.init
  const editItem = $.NSMenuItem.alloc.initWithTitleActionKeyEquivalent('Edit', null, '')
  const editMenu = $.NSMenu.alloc.initWithTitle('Edit')
  editMenu.addItemWithTitleActionKeyEquivalent('Cut', 'cut:', 'x')
  editMenu.addItemWithTitleActionKeyEquivalent('Copy', 'copy:', 'c')
  editMenu.addItemWithTitleActionKeyEquivalent('Paste', 'paste:', 'v')
  editMenu.addItemWithTitleActionKeyEquivalent('Select All', 'selectAll:', 'a')
  editItem.submenu = editMenu
  menubar.addItem(editItem)
  app.mainMenu = menubar
}

function readForm(formPath) {
  const nsPath = $.NSString.stringWithUTF8String(formPath)
  const data = $.NSData.dataWithContentsOfFile(nsPath)
  if (!data) return null
  const obj = $.NSJSONSerialization.JSONObjectWithDataOptionsError(data, 0, null)
  if (!obj) return null
  return ObjC.deepUnwrap(obj)
}

const opts = parseArgs()
const form = readForm(opts.formPath)
if (!form || !Array.isArray(form.fields) || form.fields.length < 1) {
  writeJson({ ok: false, code: 'form_invalid' })
} else {
  installTextEditing()
  $.NSApplication.sharedApplication.activateIgnoringOtherApps(true)

  const alert = $.NSAlert.alloc.init
  alert.messageText = String(form.title || 'Secrets Manager')
  alert.informativeText = String(form.info || 'Paste values locally. Secrets are written to Secrets Manager, never to chat.')
  alert.addButtonWithTitle('Save')
  alert.addButtonWithTitle('Cancel')

  const fields = form.fields
  const width = 420
  const rowHeights = fields.map(function (field) { return field.hint ? 100 : 72 })
  const contentHeight = rowHeights.reduce(function (sum, h) { return sum + h }, 0) + 16
  const viewportHeight = Math.min(contentHeight, 320)
  // Native material respects light/dark appearance and Reduce Transparency.
  const accessory = $.NSVisualEffectView.alloc.initWithFrame($.NSMakeRect(0, 0, width, viewportHeight + 44))
  accessory.material = $.NSVisualEffectMaterialPopover
  accessory.blendingMode = $.NSVisualEffectBlendingModeBehindWindow
  accessory.state = $.NSVisualEffectStateFollowsWindowActiveState
  accessory.wantsLayer = true
  accessory.layer.cornerRadius = 14
  accessory.layer.masksToBounds = true
  const scroll = $.NSScrollView.alloc.initWithFrame($.NSMakeRect(12, 36, width - 24, viewportHeight))
  scroll.hasVerticalScroller = contentHeight > viewportHeight
  scroll.autohidesScrollers = true
  scroll.drawsBackground = false
  const content = $.NSView.alloc.initWithFrame($.NSMakeRect(0, 0, width - 38, contentHeight))
  const boxes = []
  var top = contentHeight - 8

  for (let i = 0; i < fields.length; i += 1) {
    const field = fields[i]
    const isSecret = field.kind === 'password' || field.secret === true
    const caption = String(field.label || field.sm_key) + (field.required === false ? ' (optional)' : '')
    const label = makeLabel(caption, $.NSMakeRect(4, top - 20, width - 54, 20))
    label.font = $.NSFont.systemFontOfSizeWeight(12, $.NSFontWeightSemibold)
    content.addSubview(label)
    const box = isSecret
      ? $.NSSecureTextField.alloc.initWithFrame($.NSMakeRect(4, top - 55, width - (isSecret ? 124 : 54), 30))
      : $.NSTextField.alloc.initWithFrame($.NSMakeRect(4, top - 55, width - (isSecret ? 124 : 54), 30))
    box.font = $.NSFont.systemFontOfSize(13)
    box.bezelStyle = $.NSTextFieldRoundedBezel
    box.placeholderString = isSecret ? 'Paste securely with Cmd-V' : 'Enter ' + String(field.label || 'value')
    box.setAccessibilityLabel(caption)
    box.editable = true
    box.selectable = true
    content.addSubview(box)
    if (field.hint) {
      const hint = makeLabel(String(field.hint), $.NSMakeRect(4, top - 91, width - 54, 32))
      hint.font = $.NSFont.systemFontOfSize(11)
      hint.textColor = $.NSColor.secondaryLabelColor
      hint.lineBreakMode = $.NSLineBreakByWordWrapping
      hint.maximumNumberOfLines = 2
      box.setAccessibilityHelp(String(field.hint))
      content.addSubview(hint)
    }
    const row = { sm_key: String(field.sm_key), box: box, field: field }
    if (isSecret) {
      const plain = $.NSTextField.alloc.initWithFrame(box.frame)
      plain.font = box.font
      plain.bezelStyle = $.NSTextFieldRoundedBezel
      plain.setAccessibilityLabel(caption)
      plain.hidden = true
      content.addSubview(plain)
      const button = $.NSButton.alloc.initWithFrame($.NSMakeRect(width - 116, top - 59, 66, 40))
      button.title = 'Show'
      button.bezelStyle = $.NSBezelStyleRounded
      button.font = $.NSFont.systemFontOfSize(11)
      button.setAccessibilityLabel('Show ' + caption)
      button.target = visibilityTarget
      button.action = 'toggleSecret:'
      button.tag = visibilityRows.length
      row.secureBox = box
      row.plainBox = plain
      row.button = button
      row.caption = caption
      row.revealed = false
      visibilityRows.push(row)
      content.addSubview(button)
    }
    boxes.push(row)
    top -= rowHeights[i]
  }
  scroll.documentView = content
  content.scrollPoint($.NSMakePoint(0, contentHeight))
  accessory.addSubview(scroll)
  const footer = makeLabel('Hidden entry  |  Cmd-V paste  |  Tab next field', $.NSMakeRect(16, 8, width - 32, 20))
  footer.font = $.NSFont.systemFontOfSize(11)
  footer.textColor = $.NSColor.secondaryLabelColor
  footer.lineBreakMode = $.NSLineBreakByWordWrapping
  accessory.addSubview(footer)

  alert.accessoryView = accessory
  if (boxes.length > 0) {
    try {
      alert.window.initialFirstResponder = boxes[0].box
      alert.window.makeFirstResponder(boxes[0].box)
    } catch (error) {
      boxes[0].box.becomeFirstResponder
    }
  }

  var saved = false
  while (true) {
    const response = alert.runModal()
    saved = response === $.NSAlertFirstButtonReturn || Number(response) === 1000
    if (!saved) break
    var invalid = null
    for (let i = 0; i < boxes.length; i += 1) {
      const length = unwrap(boxes[i].box.stringValue).length
      const field = boxes[i].field
      const minimum = field.min_length === undefined ? (field.required === false ? 0 : 1) : field.min_length
      const maximum = field.max_length === undefined ? 4096 : field.max_length
      if ((length === 0 && field.required !== false) || (length > 0 && (length < minimum || length > maximum))) {
        invalid = boxes[i]
        break
      }
    }
    if (!invalid) break
    footer.stringValue = 'Check the highlighted field: a required value or its length is invalid.'
    footer.textColor = $.NSColor.systemRedColor
    alert.window.initialFirstResponder = invalid.box
    alert.window.makeFirstResponder(invalid.box)
    invalid.box.selectText(null)
  }
  if (!saved) {
    writeJson({ ok: false, cancelled: true, code: 'cancelled' })
  } else {
    const values = {}
    for (let i = 0; i < boxes.length; i += 1) {
      const text = unwrap(boxes[i].box.stringValue)
      if (text.length > 0) {
        values[boxes[i].sm_key] = text
      }
    }
    writeJson({ ok: true, cancelled: false, values: values })
  }
}
